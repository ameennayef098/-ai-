# سايبو — مفاتيح API
# انسخ هذا الملف إلى .env وأضف مفاتيحك للتشغيل المحلي.
# على Render: أضف المفاتيح من Environment Variables في لوحة الخدمة.
# NVIDIA NIM API (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ElevenLabs API (https://elevenlabs.io) — يحتاج صلاحيات tts + speech_to_text
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
